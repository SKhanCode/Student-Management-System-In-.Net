<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SMS</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- CRITICAL FIX: Font Awesome CDN for the icons (Graduation Cap, Folders, etc.) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            background-color: #f4f7f6;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Navbar Styling */
        .navbar-dark {
            background-color: #1c2025 !important;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: 1px;
        }

        .nav-link {
            font-weight: 500;
            margin-left: 10px;
            transition: color 0.2s;
        }

            .nav-link:hover {
                color: #ffc107 !important;
            }

        /* Footer Styling */
        .footer {
            text-align: center;
            padding: 30px 0;
            color: #6c757d;
            margin-top: auto;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Modern Dark Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark py-3">
        <div class="container">
            <a class="navbar-brand" href="/Home/Index">
                <i class="fas fa-graduation-cap text-warning me-2"></i> SMS
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link text-white" href="/Home/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/Student/Index">All Students</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/Home/About">About</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/Home/Privacy">Privacy</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <div class="container body-content mt-4 flex-grow-1">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="footer mt-5">
        <div class="container border-top pt-4">
            <p>&copy; @DateTime.Now.Year - StudentManagementSystem - <a href="/Home/Privacy" class="text-decoration-none text-primary">Privacy</a></p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>