@{
    ViewBag.Title = "Privacy Policy";
}

<div class="mt-4 mx-auto" style="max-width: 900px;">

    <div class="d-flex align-items-center mb-4">
        <i class="fas fa-lock fs-1 text-warning me-3" style="text-shadow: 0 2px 4px rgba(0,0,0,0.2);"></i>
        <h2 class="fw-bold mb-0">Privacy Policy</h2>
    </div>

    <div class="card card-custom p-5 bg-white border" style="border-radius: 15px;">

        <p class="fs-5 text-secondary mb-4 lh-lg" style="font-weight: 300;">
            This Student Management System is built as a technical demonstration and portfolio project. All data entered into this system is managed locally and treated with strict confidentiality.
        </p>

        <hr style="opacity: 0.1;" class="mb-4" />

        <div class="mb-4">
            <p class="text-dark mb-3"><strong class="text-dark">Data Collection:</strong> We only process student information explicitly provided through the official input forms.</p>

            <hr style="opacity: 0.1;" class="mb-3" />

            <p class="text-dark mb-3"><strong class="text-dark">Data Usage:</strong> Information is used exclusively to demonstrate Create, Read, Update, and Delete (CRUD) operations.</p>

            <hr style="opacity: 0.1;" class="mb-3" />

            <p class="text-dark mb-0"><strong class="text-dark">Security Protocol:</strong> We implement server-side validation and secure operations to protect data integrity and prevent permanent accidental loss.</p>
        </div>

    </div>
</div>