    <div class="col-md-4">
        <div class="d-flex align-items-start">
            <div class="bg-white rounded shadow-sm me-3 border d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; flex-shrink: 0;">
                <i class="fas fa-search fs-4 text-dark"></i>
