<!-- Auto-Typing CSS -->
<style>
    .blinking-cursor {
        animation: blink 1s step-end infinite;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }
</style>

<!-- Auto-Typing JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const phrases = [
            "Seamless Management.",
            "Rapid Search Queries.",
            "Secure Data Architecture."
        ];

        let currentPhraseIndex = 0;
        let currentCharIndex = 0;
        let isDeleting = false;
        const element = document.getElementById('typewriter');

        function type() {
            const currentPhrase = phrases[currentPhraseIndex];
            let typingSpeed = isDeleting ? 50 : 100; // Type fast, delete faster

            if (isDeleting) {
                element.textContent = currentPhrase.substring(0, currentCharIndex - 1);
                currentCharIndex--;
            } else {
                element.textContent = currentPhrase.substring(0, currentCharIndex + 1);
                currentCharIndex++;
            }

            // Word finished typing
            if (!isDeleting && currentCharIndex === currentPhrase.length) {
                isDeleting = true;
                typingSpeed = 2000; // Pause for 2 seconds before deleting
            }
            // Word finished deleting
            else if (isDeleting && currentCharIndex === 0) {
                isDeleting = false;
                currentPhraseIndex = (currentPhraseIndex + 1) % phrases.length;
                typingSpeed = 500; // Pause half a second before typing new word
            }

            setTimeout(type, typingSpeed);
        }

        // Start the effect after a brief delay
        setTimeout(type, 800);
    });
</script>