@{
    ViewBag.Title = "Student List";
}

<div class="container-fluid mt-4 mb-5 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Student Management System</h2>
        @Html.ActionLink("Add New Student", "AddStudent", "Student", null, new { @class = "btn btn-primary shadow-sm" })
    </div>
    <hr />

    <div class="table-responsive shadow-sm bg-white border rounded">
        <table class="table table-hover table-borderless mb-0">
            <thead class="table-light border-bottom">
                <tr>
                    <th class="p-3 text-secondary">ID</th>
                    <th class="p-3 text-secondary">Student</th>
                    <th class="p-3 text-secondary">Academics</th>
                    <th class="p-3 text-secondary">Location</th>
                    <th class="p-3 text-secondary text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.StudentList != null)
                {
                    foreach (var item in ViewBag.StudentList)
                    {
                        <tr class="border-bottom">
                            <!-- ID -->
                            <td class="p-3 align-middle text-muted">#@item.StudentId</td>

                            <!-- Grouped: Name & Email -->
                            <td class="p-3 align-middle">
                                <div class="fw-bold text-dark fs-6">@item.StudentName</div>
                                <div class="text-muted small">@item.Email</div>
                            </td>

                            <!-- Grouped: Course & Department -->
                            <td class="p-3 align-middle">
                                <div class="fw-bold text-primary">@item.CourseName</div>
                                <div class="text-muted small">@item.DepartmentName</div>
                            </td>

                            <!-- Grouped: City, State, Country -->
                            <td class="p-3 align-middle">
                                <div class="fw-bold text-dark">@item.CityName</div>
                                <div class="text-muted small">@item.StateName, @item.CountryName</div>
                            </td>

                            <!-- Action Buttons -->
                            <td class="p-3 align-middle text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    @Html.ActionLink("Edit", "AddStudent", new { id = item.StudentId }, new { @class = "btn btn-sm btn-warning shadow-sm fw-semibold px-3 text-dark" })
                                    @Html.ActionLink("Delete", "DeleteStudent", new { id = item.StudentId }, new { onclick = "return confirm('Are you sure you want to delete this record?');", @class = "btn btn-sm btn-danger shadow-sm fw-semibold px-3 text-white" })
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center p-5 text-muted fs-5">No students found in the directory.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>